APP_NAME="AErchi.ba"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=sqlite
CACHE_STORE=file
SESSION_DRIVER=file
LOG_CHANNEL=stack
IMPORT_USER_AGENT="AErchiBiH/1.0 (+contact@example.com)"
IMPORT_DELAY_MS=100
IMPORT_PRODUCT_LIMIT=0
IMPORT_PAGE_LIMIT=0
IMPORT_CONCURRENCY=8
# Optional PEM bundle if the PHP runtime lacks trusted system certificates.
IMPORT_CA_BUNDLE=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=
# Optional override; defaults to the local .runtime/lens-venv Python executable.
LENS_PYTHON=
# Watch emails require SMTP and recipient verification. Default: inbox only.
MAIL_MAILER=log
